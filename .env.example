# =====================================================================
# JobSense environment configuration
# Copy to backend/.env (backend) and set real values. NEVER commit .env files.
# Frontend variables live in frontend/.env (see frontend/.env.example).
# =====================================================================

# ---- Flask ----
FLASK_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
LOG_LEVEL=INFO
# Session token lifetime (hours)
TOKEN_TTL_HOURS=168

# ---- MySQL (local MySQL 8 or Railway MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jobsense
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=5
# Railway's public proxy works without TLS by default; set to false to require TLS
DB_SSL_DISABLED=true
# Database used by pytest integration tests (created automatically)
TEST_DB_NAME=jobsense_test

# ---- CORS: comma-separated list of allowed frontend origins ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Resume uploads ----
MAX_RESUME_SIZE_MB=5
# UPLOAD_FOLDER=./uploads

# ---- Job provider ----
# auto   = JSearch when JSEARCH_API_KEY is set, otherwise the clearly-labelled mock provider
# jsearch = always JSearch (production)
# mock   = always mock data (development / testing only)
JOB_PROVIDER=auto
# OpenWeb Ninja JSearch API key (server-side only - never put this in the frontend)
JSEARCH_API_KEY=
JSEARCH_BASE_URL=https://api.openwebninja.com/jsearch
JSEARCH_TIMEOUT_SECONDS=45
JOB_SEARCH_CACHE_SECONDS=900

# ---- Matching weights (initial values; adjust during evaluation) ----
TEXT_SIMILARITY_WEIGHT=0.40
SKILL_MATCH_WEIGHT=0.60
CAREER_SKILL_WEIGHT=0.75
CAREER_TEXT_WEIGHT=0.15
CAREER_INTEREST_WEIGHT=0.10
MATCH_POOL_LIMIT=300
